# Option A: ready OpenMapTiles-compatible style URL (recommended for quick start)
# OpenFreeMap Liberty is free, no API key, OpenMapTiles schema:
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Option B: self-hosted OpenMapTiles vector tile endpoint (optional).
# When set, the app can inject/override the vector source tiles URL.
# Example: http://localhost:8080/data/v3/{z}/{x}/{y}.pbf
NEXT_PUBLIC_MAPTILES_URL=

# F4map demo camera defaults (Yerevan)
# https://demo.f4map.com/#lat=40.2072833&lon=44.5189334&zoom=18&camera.phi=-17.59
NEXT_PUBLIC_MAP_CENTER_LNG=44.5189334
NEXT_PUBLIC_MAP_CENTER_LAT=40.2072833
NEXT_PUBLIC_MAP_INITIAL_ZOOM=18
NEXT_PUBLIC_MAP_INITIAL_PITCH=62
NEXT_PUBLIC_MAP_INITIAL_BEARING=-17.59

# Optional Terrarium DEM tiles for ground elevations
# NEXT_PUBLIC_TERRAIN_TILES_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# Free Overpass API endpoint for OSM roads → vehicle simulation (no API key)
# Defaults to https://overpass-api.de/api/interpreter
# NEXT_PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional: max GLB upload size in bytes (default 25 MB)
NEXT_PUBLIC_MAX_GLB_BYTES=26214400

# Neon PostgreSQL (pooled — app runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Neon PostgreSQL (direct — migrations; no -pooler in host)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full
