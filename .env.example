# Option A: ready OpenMapTiles-compatible style URL (recommended for quick start)
# OpenFreeMap Liberty is free, no API key, OpenMapTiles schema:
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Option B: self-hosted OpenMapTiles vector tile endpoint (optional).
# When set, the app can inject/override the vector source tiles URL.
# Example: http://localhost:8080/data/v3/{z}/{x}/{y}.pbf
NEXT_PUBLIC_MAPTILES_URL=

# Map initial view — F4map demo camera defaults (Yerevan)
# https://demo.f4map.com/#lat=40.2119757&lon=44.5236047&zoom=17&camera.theta=69&camera.phi=38
NEXT_PUBLIC_MAP_CENTER_LNG=44.5236047
NEXT_PUBLIC_MAP_CENTER_LAT=40.2119757
NEXT_PUBLIC_MAP_INITIAL_ZOOM=17
NEXT_PUBLIC_MAP_INITIAL_PITCH=69
NEXT_PUBLIC_MAP_INITIAL_BEARING=38

# Optional Terrarium DEM tiles for ground elevations
# NEXT_PUBLIC_TERRAIN_TILES_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# Optional: max GLB upload size in bytes (default 25 MB)
NEXT_PUBLIC_MAX_GLB_BYTES=26214400
